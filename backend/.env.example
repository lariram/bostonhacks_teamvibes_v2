# Copy this file to backend/.env and fill in what you have. Everything is optional.
# backend/.env is gitignored, so keys never get committed.

# ── Live events ─────────────────────────────────────────────
# With no keys, the app already pulls today's events from public calendars:
#   universities (MIT, Northeastern, BU, Boston College) and community calendars
#   (Downtown Boston, Massachusetts 250, SoWa).

# Ticketmaster Discovery API: concerts, sports, comedy, theater at Boston venues.
# Free key: https://developer.ticketmaster.com (create an app → "Consumer Key")
TICKETMASTER_API_KEY=

# Google's event listings via SerpApi (Google has no public events API).
# Free tier: https://serpapi.com. Each refresh uses one search.
SERPAPI_API_KEY=
GOOGLE_EVENTS_REFRESH_HOURS=12

# Which public calendars to include (comma-separated). Default: all of them.
# LOCALIST_CALENDARS=calendar.mit.edu,calendar.northeastern.edu,butodayevents.bu.edu,events.bc.edu
# COMMUNITY_CALENDARS=www.downtownboston.org,massachusetts250.org,www.sowaboston.com

# Turn live events off entirely (catalog only):
# LIVE_EVENTS=off

# ── Photos ───────────────────────────────────────────────────
# Live events use the photo from their own listing. Curated places use real,
# freely licensed photos from Wikipedia/Wikimedia Commons (no key needed, ~1/3
# of places). For photos of nearly every place (restaurants too), add a Google
# Places API key: console.cloud.google.com → enable "Places API (New)" → create
# an API key. Needs billing turned on; there's a monthly free allowance.
GOOGLE_PLACES_API_KEY=
# PHOTOS=off
